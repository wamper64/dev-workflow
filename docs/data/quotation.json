{
  "title": "报价系统首次项目建设研发导航",
  "version": "方案草案",
  "updated": "2026-10-10",
  "overview": "基于现有input资料、前端原型及若依后端框架，先识别模块，再按依赖选模块迭代开发，最后全项目验收上线。",
  "inputs": [
    {
      "name": "需求资料",
      "path": "input/需求资料/",
      "desc": "已确认的项目PRD与模块需求"
    },
    {
      "name": "工程资料",
      "path": "input/工程资料/",
      "desc": "已有方案、技术选型、技术约束；可为空"
    },
    {
      "name": "环境资料",
      "path": "input/环境资料/",
      "desc": "本地或服务器信息；可为空"
    },
    {
      "name": "对接资料",
      "path": "input/对接资料/",
      "desc": "第三方API及设备协议等；可为空"
    },
    {
      "name": "前端原型",
      "path": "code/fld/",
      "desc": "在现有原型上开发，复用已有样式与组件"
    },
    {
      "name": "若依后端",
      "path": "code/guiwu_ruoyi/",
      "desc": "在既有框架内实现和扩展"
    }
  ],
  "phases": [
    {
      "id": "P01",
      "title": "确认项目原始输入",
      "kind": "once",
      "owner": "开发人员、项目经理",
      "description": "接收已确认的PRD、可选工程/环境/对接资料和原型/框架，不重做需求调研。",
      "steps": [
        {
          "id": "S01",
          "title": "核对 input 四类资料",
          "skills": [
            "dev-project-init"
          ],
          "inputs": [
            "input/需求资料/PRD",
            "input/工程资料/",
            "input/环境资料/",
            "input/对接资料/"
          ],
          "outputs": [
            "doc/output/项目总控/输入核对.md",
            "doc/output/项目总控/待确认问题.md"
          ],
          "review": "项目经理核实资料完整性，缺失的可选资料不强制补齐"
        },
        {
          "id": "S02",
          "title": "初始化 Agent 与 Matt 工作约定",
          "skills": [
            "setup-matt-pocock-skills",
            "dev-project-control"
          ],
          "inputs": [
            "code/",
            "input/工程资料/",
            "现有 AGENTS.md 或 CLAUDE.md"
          ],
          "outputs": [
            "AGENTS.md（复用或更新）",
            "docs/agents/issue-tracker.md",
            "docs/agents/domain.md"
          ],
          "review": "确认Git提交用中文、前端保持原型设计，配置本地Markdown任务跟踪"
        }
      ],
      "artifacts": [
        "doc/output/项目总控/输入核对.md",
        "doc/output/项目总控/待确认问题.md",
        "AGENTS.md（复用或更新）"
      ]
    },
    {
      "id": "P02",
      "title": "扫描现有前后端",
      "kind": "once",
      "owner": "开发人员",
      "description": "扫描原型页面和若依现有能力，找到真实代码位置及可复用能力。",
      "steps": [
        {
          "id": "S03",
          "title": "扫描前端原型与页面",
          "skills": [
            "dev-engine-baseline",
            "dev-ui-guard"
          ],
          "inputs": [
            "code/fld/",
            "input/需求资料/"
          ],
          "outputs": [
            "doc/output/项目总控/原型页面映射.md",
            "doc/output/项目总控/原型复用约束.md"
          ],
          "review": "覆盖登录与17个菜单；已有样式和组件优先复用，不另建重复UI"
        },
        {
          "id": "S04",
          "title": "扫描若依后端复用能力",
          "skills": [
            "dev-engine-baseline",
            "codebase-design"
          ],
          "inputs": [
            "code/guiwu_ruoyi/",
            "input/工程资料/"
          ],
          "outputs": [
            "doc/output/项目总控/后端框架复用清单.md"
          ],
          "review": "明确哪些认证、角色、菜单、日志、数据能力可直接复用"
        },
        {
          "id": "S05",
          "title": "验证本地可运行基线",
          "skills": [
            "dev-environment-check",
            "diagnosing-bugs"
          ],
          "inputs": [
            "code/",
            "本地已有开发依赖",
            "input/环境资料/"
          ],
          "outputs": [
            "doc/output/项目总控/本地环境验证.md"
          ],
          "review": "能启动前后端并连接本地依赖，失败项有定位证据"
        }
      ],
      "artifacts": [
        "doc/output/项目总控/原型页面映射.md",
        "doc/output/项目总控/原型复用约束.md",
        "doc/output/项目总控/后端框架复用清单.md"
      ]
    },
    {
      "id": "P03",
      "title": "识别并审核项目模块",
      "kind": "once",
      "owner": "项目经理、技术总监、开发人员",
      "description": "正式进行模块划分，13个候选模块不代表已审定，不能预设8个Spec。",
      "steps": [
        {
          "id": "S06",
          "title": "提取 PRD 与原型业务能力",
          "skills": [
            "dev-module-map",
            "domain-modeling"
          ],
          "inputs": [
            "input/需求资料/PRD",
            "原型页面映射.md"
          ],
          "outputs": [
            "doc/output/项目总控/候选能力清单.md",
            "GLOSSARY.md"
          ],
          "review": "功能覆盖无遗漏；跨页面业务不被拆成互不关联的孤岛"
        },
        {
          "id": "S07",
          "title": "按业务职责划分候选模块",
          "skills": [
            "dev-module-map",
            "codebase-design"
          ],
          "inputs": [
            "候选能力清单.md",
            "code/fld/",
            "code/guiwu_ruoyi/"
          ],
          "outputs": [
            "doc/output/项目总控/候选模块清单.md",
            "doc/output/项目总控/模块页面映射.md"
          ],
          "review": "模块按职责、数据和业务闭环划分，而非一个菜单等于一个Spec"
        },
        {
          "id": "S08",
          "title": "梳理模块之间的前置依赖",
          "skills": [
            "dev-module-map",
            "domain-modeling"
          ],
          "inputs": [
            "候选模块清单.md",
            "相关PRD场景"
          ],
          "outputs": [
            "doc/output/项目总控/模块依赖关系.md"
          ],
          "review": "识别项目主数据、模板、参数版本、匹配、审批等跨模块依赖"
        },
        {
          "id": "S09",
          "title": "审核模块划分并确定范围",
          "skills": [
            "dev-project-control",
            "grill-with-docs"
          ],
          "inputs": [
            "候选模块清单.md",
            "模块依赖关系.md",
            "项目PRD"
          ],
          "outputs": [
            "doc/output/项目总控/项目模块清单.md",
            "doc/output/项目总控/模块划分审核.md"
          ],
          "review": "项目经理确认范围，技术总监确认边界；批准后确定本项目实际模块数"
        }
      ],
      "artifacts": [
        "doc/output/项目总控/候选能力清单.md",
        "GLOSSARY.md",
        "doc/output/项目总控/候选模块清单.md"
      ]
    },
    {
      "id": "P04",
      "title": "建立共享工程基线",
      "kind": "once",
      "owner": "技术总监、开发人员",
      "description": "只统一跨模块技术规则；模块内部详细设计延后到本轮开发。",
      "steps": [
        {
          "id": "S10",
          "title": "确定项目级架构与工程约束",
          "skills": [
            "dev-architecture",
            "codebase-design"
          ],
          "inputs": [
            "input/工程资料/",
            "后端复用清单.md",
            "已确认模块清单.md"
          ],
          "outputs": [
            "doc/output/工程基线/工程基线.md",
            "docs/adr/架构决策.md"
          ],
          "review": "不重建前端，不替换若依；技术总监审核核心架构与边界"
        },
        {
          "id": "S11",
          "title": "确定核心数据与跨模块契约",
          "skills": [
            "dev-architecture",
            "domain-modeling"
          ],
          "inputs": [
            "项目模块清单.md",
            "模块依赖关系.md",
            "项目PRD"
          ],
          "outputs": [
            "doc/output/工程基线/核心数据模型.md",
            "doc/output/工程基线/公共接口约定.md"
          ],
          "review": "统一项目ID、计算单、参数版本、报价状态、权限等公共约定"
        }
      ],
      "artifacts": [
        "doc/output/工程基线/工程基线.md",
        "docs/adr/架构决策.md",
        "doc/output/工程基线/核心数据模型.md"
      ]
    },
    {
      "id": "P05",
      "title": "选择本轮开发模块",
      "kind": "repeat",
      "owner": "开发人员、项目经理",
      "description": "按依赖和当前实际进展选若干模块，只为本轮已确定内容详细设计。",
      "steps": [
        {
          "id": "S12",
          "title": "根据模块清单选择本轮范围",
          "skills": [
            "dev-iteration-plan",
            "dev-project-control"
          ],
          "inputs": [
            "项目模块清单.md",
            "模块依赖关系.md",
            "项目实施状态.md"
          ],
          "outputs": [
            "doc/output/迭代/本轮开发计划.md"
          ],
          "review": "项目经理确认本轮业务目标，开发人员判断并行和前后顺序"
        },
        {
          "id": "S13",
          "title": "核查前置契约和第三方条件",
          "skills": [
            "dev-iteration-plan",
            "research"
          ],
          "inputs": [
            "本轮开发计划.md",
            "input/对接资料/",
            "工程基线.md"
          ],
          "outputs": [
            "doc/output/迭代/前置依赖检查.md"
          ],
          "review": "缺少项目主数据、字典归一或第三方能力时，补最小前置任务或标明阻塞"
        }
      ],
      "artifacts": [
        "doc/output/迭代/本轮开发计划.md",
        "doc/output/迭代/前置依赖检查.md"
      ]
    },
    {
      "id": "P06",
      "title": "逐模块执行 Spec、Tickets 和开发",
      "kind": "repeat",
      "owner": "开发人员",
      "description": "一个模块一份或按复杂度拆分Spec，每个Ticket要端到端可验证；允许同轮多个模块并行。",
      "steps": [
        {
          "id": "S14",
          "title": "核对本模块业务与现有实现",
          "skills": [
            "grill-with-docs",
            "codebase-design"
          ],
          "inputs": [
            "本模块PRD",
            "对应原型页面",
            "工程基线",
            "当前业务代码"
          ],
          "outputs": [
            "按需：docs/adr/模块决策.md"
          ],
          "review": "只确认原型与文档未覆盖的业务问题，不重复全项目调研"
        },
        {
          "id": "S15",
          "title": "生成当前模块 Spec",
          "skills": [
            "to-spec"
          ],
          "inputs": [
            "本模块PRD",
            "模块设计决策",
            "已有原型",
            "共享工程基线"
          ],
          "outputs": [
            " .scratch/<module>/spec.md"
          ],
          "review": "用户故事、实现与测试决策完整，说明范围外事项"
        },
        {
          "id": "S16",
          "title": "拆分纵向 Tickets 和依赖",
          "skills": [
            "to-tickets"
          ],
          "inputs": [
            " .scratch/<module>/spec.md",
            "前置依赖检查.md"
          ],
          "outputs": [
            " .scratch/<module>/issues/NN-*.md"
          ],
          "review": "每个任务跨数据库、接口、UI及测试，阻塞关系明确"
        },
        {
          "id": "S17",
          "title": "按 Tickets 执行 TDD 和工程实现",
          "skills": [
            "implement-spec",
            "implement",
            "tdd"
          ],
          "inputs": [
            "相关Tickets",
            "code/fld/",
            "code/guiwu_ruoyi/"
          ],
          "outputs": [
            "code/fld/实际前端代码",
            "code/guiwu_ruoyi/后端代码",
            "database/migrations/",
            "自动测试代码"
          ],
          "review": "修改既有原型和若依框架，先测再实现，通过可运行反馈"
        },
        {
          "id": "S18",
          "title": "原型守护与代码评审",
          "skills": [
            "dev-ui-guard",
            "code-review",
            "pr"
          ],
          "inputs": [
            "开发Diff",
            "对应Spec",
            "原型样式约束"
          ],
          "outputs": [
            "代码审核结果",
            "Git中文提交",
            "Ticket状态"
          ],
          "review": "禁止未经确认的新样式体系、平行页面和偏离Spec的代码"
        }
      ],
      "artifacts": [
        "按需：docs/adr/模块决策.md",
        " .scratch/<module>/spec.md",
        " .scratch/<module>/issues/NN-*.md"
      ]
    },
    {
      "id": "P07",
      "title": "本轮集成、验收和回退",
      "kind": "repeat",
      "owner": "开发人员、项目经理",
      "description": "业务模块开发不能只做单独页面，要与当前系统整合后完成本轮场景验收。",
      "steps": [
        {
          "id": "S19",
          "title": "将本轮模块接入当前系统",
          "skills": [
            "dev-integration",
            "dev-contract-check"
          ],
          "inputs": [
            "本轮各模块代码",
            "公共API契约",
            "迁移SQL"
          ],
          "outputs": [
            "doc/output/迭代/本轮联调记录.md",
            "可运行的前后端集成版本"
          ],
          "review": "跨模块业务、登录权限、既有模块回归通过"
        },
        {
          "id": "S20",
          "title": "按角色和业务场景验收",
          "skills": [
            "dev-module-acceptance",
            "dev-ui-guard"
          ],
          "inputs": [
            "本轮PRD",
            "原型",
            "联调结果"
          ],
          "outputs": [
            "doc/output/迭代/本轮验收记录.md",
            "E2E测试"
          ],
          "review": "项目经理按业务场景验收，样式、权限、异常行为符合基线"
        },
        {
          "id": "S21",
          "title": "缺陷返工或本轮收口",
          "skills": [
            "triage",
            "diagnosing-bugs",
            "tdd",
            "dev-project-control"
          ],
          "inputs": [
            "本轮验收记录.md",
            "失败测试"
          ],
          "outputs": [
            " .scratch/defects/issues/*.md",
            "项目实施状态.md（更新）"
          ],
          "review": "失败回到相关Ticket测试和修复；通过后返回P05选下一轮"
        }
      ],
      "artifacts": [
        "doc/output/迭代/本轮联调记录.md",
        "可运行的前后端集成版本",
        "doc/output/迭代/本轮验收记录.md"
      ]
    },
    {
      "id": "P08",
      "title": "全项目系统验收",
      "kind": "final",
      "owner": "项目经理、开发人员、技术总监",
      "description": "范围内所有模块完成后验证完整业务链和全局一致性。",
      "steps": [
        {
          "id": "S22",
          "title": "全项目业务链路与回归测试",
          "skills": [
            "dev-acceptance",
            "dev-integration"
          ],
          "inputs": [
            "项目模块清单.md",
            "所有模块验收",
            "可运行系统"
          ],
          "outputs": [
            "doc/output/系统验收/全流程验收报告.md",
            "缺陷回归测试"
          ],
          "review": "登录→项目→解析→匹配→成本→报价→审批→交付→归档及全部17菜单"
        },
        {
          "id": "S23",
          "title": "全项目交付审核",
          "skills": [
            "dev-project-control",
            "code-review"
          ],
          "inputs": [
            "系统验收报告.md",
            "项目实施状态.md"
          ],
          "outputs": [
            "doc/output/系统验收/交付评审结论.md"
          ],
          "review": "关键场景必须通过，未关闭问题有明确结论，技术总监与项目经理确认"
        }
      ],
      "artifacts": [
        "doc/output/系统验收/全流程验收报告.md",
        "缺陷回归测试",
        "doc/output/系统验收/交付评审结论.md"
      ]
    },
    {
      "id": "P09",
      "title": "部署上线与首次交付",
      "kind": "final",
      "owner": "开发人员、技术总监、项目经理",
      "description": "目标服务器部署、实际业务冒烟及交付；正式上线前必须预演。",
      "steps": [
        {
          "id": "S24",
          "title": "环境核对与部署预演",
          "skills": [
            "dev-release",
            "wizard"
          ],
          "inputs": [
            "input/环境资料/",
            "代码与SQL",
            "系统验收报告"
          ],
          "outputs": [
            "deploy/docker-compose.yml",
            "deploy/nginx/",
            "doc/output/上线交付/部署预演.md"
          ],
          "review": "验证配置、迁移、备份、回滚和关键接口；没有真实环境不声称已上线"
        },
        {
          "id": "S25",
          "title": "发布、冒烟测试与交付复盘",
          "skills": [
            "dev-release",
            "retro"
          ],
          "inputs": [
            "部署预演结果",
            "可发布代码",
            "上线审核结论"
          ],
          "outputs": [
            "doc/output/上线交付/上线记录.md",
            "doc/output/上线交付/交付清单.md"
          ],
          "review": "实际部署验证并交付完整源码、文档、迁移和部署脚本"
        }
      ],
      "artifacts": [
        "deploy/docker-compose.yml",
        "deploy/nginx/",
        "doc/output/上线交付/部署预演.md"
      ]
    }
  ],
  "modules": [
    {
      "id": "M01",
      "title": "身份与权限",
      "menus": [
        "用户与角色"
      ],
      "additional": "登录入口",
      "dependsOn": [],
      "scope": "复用若依已有认证、菜单、权限能力",
      "readiness": "须完成依赖契约或补齐最小前置Ticket后才能进入完整功能开发",
      "ticketExamples": [
        "用户/角色管理",
        "数据权限核对"
      ],
      "artifacts": [
        ".scratch/quote-m01/spec.md",
        ".scratch/quote-m01/issues/*.md",
        "code/fld/原型现有文件（持续扩展）",
        "code/guiwu_ruoyi/原框架扩展",
        "按需：database/migrations/*.sql",
        "doc/output/迭代/M01-模块验收.md"
      ]
    },
    {
      "id": "M02",
      "title": "报价项目管理",
