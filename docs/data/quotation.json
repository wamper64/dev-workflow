      "title": "拆分可验证开发Tickets",
      "skills": [
        "to-tickets"
      ],
      "inputs": [
        "本模块Spec"
      ],
      "outputs": [
        " .scratch/<module>/issues/*.md"
      ],
      "review": "按纵向业务切片，标注依赖"
    },
    {
      "id": "I05",
      "title": "执行TDD与前后端开发",
      "skills": [
        "implement-spec",
        "implement",
        "tdd"
      ],
      "inputs": [
        "Tickets",
        "已有前后端代码"
      ],
      "outputs": [
        "源代码",
        "SQL",
        "自动测试"
      ],
      "review": "按依赖执行，严格沿用原型"
    },
    {
